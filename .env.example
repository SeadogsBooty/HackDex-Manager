# ============================================================
# HackDex Manager
# Example environment configuration
#
# Copy to .env:
#
#   cp .env.example .env
#
# Local .env files are intentionally excluded from Git and
# the Docker build context.
# ============================================================

# Optional published image.
#
# Leave this unset for a source-based local build, or set it
# to the image supplied by your registry/repository.
#
# HACKDEX_IMAGE=registry.example/hackdex-manager:v0.9.1

# Container permissions
#
# These values must have write access to:
#   HACKDEX_DATA_PATH
#   HACKDEX_STAGING_PATH
#   HACKDEX_HACKS_PATH
#
# Run `id` on the Docker host to determine your UID/GID.
PUID=1000
PGID=1000

# Web port
HACKDEX_PORT=8080

# Timezone
TZ=UTC

# DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Persistent application storage
HACKDEX_DATA_PATH=./data
HACKDEX_STAGING_PATH=./staging

# Clean/general ROM source.
# Mounted read-only inside HackDex Manager at /roms.
ROM_PATH=./roms

# Writable ROM-hack parent.
# Mounted inside HackDex Manager at /hacks.
HACKDEX_HACKS_PATH=./hacks

# ============================================================
# Advanced provider overrides
#
# Normal users should NOT need these.
# HackDex Manager includes its normal public HackDex provider
# configuration internally.
# ============================================================

# HACKDEX_SUPABASE_URL=
# HACKDEX_SUPABASE_KEY=
# HACKDEX_COVERS_BASE_URL=
