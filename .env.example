# ============================================================
# HackDex Manager
# Example environment configuration
#
# Copy to .env:
#
#   cp .env.example .env
#
# You may also put literal values directly into compose.yaml.
# ============================================================

# Container permissions
#
# These values must have write access to HACKDEX_DATA_PATH
# and HACKDEX_STAGING_PATH on the Docker host.
# Run `id` on the host to determine your UID/GID.
PUID=1000
PGID=1000

# Web port
HACKDEX_PORT=8080

# Timezone
TZ=UTC

# DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Persistent application storage
HACKDEX_DATA_PATH=./data
HACKDEX_STAGING_PATH=./staging

# General ROM source
ROM_PATH=./roms

# Per-platform hack libraries
GBA_HACK_PATH=./roms/gba-hacks
GB_HACK_PATH=./roms/gb-hacks
GBC_HACK_PATH=./roms/gbc-hacks
NDS_HACK_PATH=./roms/nds-hacks

# ============================================================
# Advanced provider overrides
#
# Normal users should NOT need these.
# HackDex Manager will include its normal public HackDex
# provider configuration internally.
# ============================================================

# HACKDEX_SUPABASE_URL=
# HACKDEX_SUPABASE_KEY=
# HACKDEX_COVERS_BASE_URL=
