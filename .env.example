# HackDex Manager
#
# This file is optional.
# Copy it to .env only if you prefer environment-based
# configuration instead of editing compose.yaml directly.

PUID=1000
PGID=1000

HACKDEX_PORT=8095

TZ=UTC
LOG_LEVEL=INFO

HACKDEX_DATA_PATH=./data
HACKDEX_STAGING_PATH=./staging
HACKDEX_BACKUPS_PATH=./backups

ROM_PATH=./roms
HACKDEX_HACKS_PATH=./hacks

# Optional image override:
# HACKDEX_IMAGE=ghcr.io/seadogsbooty/hackdex-manager:1.1.3

# Optional application-update feed override.
# Leave unset to use the built-in public HackDex Manager feed.
# Set to an empty value to disable remote update checks.
# HACKDEX_UPDATE_MANIFEST_URL=

# Advanced provider overrides.
# Normal users should leave these unset.
#
# HACKDEX_SUPABASE_URL=
# HACKDEX_SUPABASE_KEY=
# HACKDEX_COVERS_BASE_URL=
